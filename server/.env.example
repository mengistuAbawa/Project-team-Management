DATABASE_URL=postgresql://localhost:5432/ptms
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
PORT=5000

# Production defaults to PostgreSQL TLS with certificate verification enabled.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Tune per deployment capacity; TRUST_PROXY should match trusted proxy hops.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=30000
REQUEST_TIMEOUT_MS=60000
HEADERS_TIMEOUT_MS=65000
SOCKET_TIMEOUT_MS=120000
# TRUST_PROXY=

# Temporary bootstrap values; remove after npm run db:create-admin.
ADMIN_NAME=Initial Administrator
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters